{
  "dependencies": {
    "jsonresume-theme-even": "^0.23.0",
    "jsonresume-theme-one": "file:./jsonresume-theme-one",
    "jsonresume-theme-stackoverflow-mats": "^2.1.0",
    "resumed": "^4.0.0"
  },
  "scripts": {
    "prebuild": "yq -I2 resume.yaml -o=json > resume.json && resumed validate",
    "build": "resumed export --output resume.html --theme jsonresume-theme-one",
    "dev": "fd resume.yaml | entr yarn build",
    "dev-theme": "fd '^resume\\.(hbs|yaml)$' | entr -s 'yarn install --force && yarn build'"
  },
  "license": "MIT"
}
